# Copy this file to ".env" (same folder) and fill in a real secret.
# The real .env is git-ignored so your secret never gets committed.
#
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# --- Food recommendation feature (Google Places API) ---
GOOGLE_PLACES_API_KEY=replace_with_your_real_key
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:5173
ENABLE_ROUTES_API=false
REQUEST_TIMEOUT_SECONDS=8
SMALL_BUDGET_THRESHOLD_EGP=120
